{
  "tasks": {
    // #region Git Hooks
    // Installs the pre-commit hook in the shared .git/hooks/. Works with
    // worktrees (resolves via git rev-parse --git-common-dir).
    "hooks:install": "deno run -R -W --allow-run=git --allow-env=GIT_DIR scripts/hooks/install.ts",
    "hooks:pre-commit": "deno task check",
    // #endregion Git Hooks

    // #region Real-server test
    // Local only, never CI: it needs HETZNER_CLOUD_API_TOKEN, which can create servers.
    // --allow-net names the API host, so `fetch` can send the token nowhere else.
    "e2e:vps": {
      "command": "deno run --allow-net=api.hetzner.cloud --allow-env --allow-run -R -W scripts/e2e-vps/+main.ts",
      "description": "🚀 Deploy to a fresh Hetzner server, check it, delete it (local | <version>)"
    },
    // #endregion Real-server test

    // #region Checks
    "check": {
      "description": "✅ Run all checks (lint, fmt, types, tests)",
      "dependencies": [
        "lint:check",
        "fmt:check",
        "ts:check",
        "test"
      ]
    },
    "fmt:fix": {
      "command": "deno fmt",
      "description": "✨ Auto-format code"
    },
    "fmt:check": {
      "command": "deno fmt --check",
      "description": "📝 Check code formatting"
    },
    "lint:fix": {
      "command": "deno lint --fix",
      "description": "🔍 Auto-fix linting issues"
    },
    "lint:check": {
      "command": "deno lint",
      "description": "🔍 Check for linting issues"
    },
    "ts:check": {
      // Bare `deno check` resolves files itself and honours the top-level
      // "exclude" list, and Deno's walker skips node_modules on its own.
      // The previous `**/*.ts` was expanded by the task shell instead,
      // which follows symlinks: one stray node_modules in the checkout
      // turns 132 checked files into ~20k paths and the launch fails with
      // "Argument list too long" — at the exit code, indistinguishable
      // from a type error.
      "command": "deno check",
      "description": "📘 Type-check TypeScript files"
    },
    "test": {
      // -R/-W: env/worktree tests build a throwaway dir tree (nested
      // worktree fixtures) under the system temp dir and walk it.
      // --allow-run: env encryption itself needs no subprocess any more
      // (@spy4x/server/env-age64 runs in-process) — this is for `git`
      // (worktree/gitignore fixtures), `ssh`/`rsync` (deploy tests) and
      // spawning `deno` itself (CLI integration tests).
      "command": "deno test --allow-env --allow-run -R -W",
      "description": "🧪 Run tests"
    },
    "fix": {
      "command": "echo '🔧 All fixes applied!'",
      "description": "🔧 Auto-fix all issues (lint + format)",
      "dependencies": [
        "lint:fix",
        "fmt:fix"
      ]
    }
    // #endregion Checks
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@rostok/cli": "./cli/+lib.ts",
    "@scripts/backup": "./scripts/backup/src/+lib.ts",
    "@std/assert": "jsr:@std/assert@^1.0.17",
    "@std/dotenv": "jsr:@std/dotenv",
    "@std/encoding": "jsr:@std/encoding@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.21",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@spy4x/platform": "jsr:@spy4x/platform@1.73.0",
    "@spy4x/server": "jsr:@spy4x/server@1.2.0",
    "arktype": "npm:arktype@^2.2.3",
    "yaml": "npm:yaml@^2.8.2"
  },
  // JSR package metadata. `rostok` ships the CLI as a publishable binary
  // at jsr.io/@rostok/cli. The default `.` export is the CLI binary
  // (per docs/design/v1-cli.md §8: `deno install -A -n rostok
  // jsr:@rostok/cli` should give the binary). Library consumers
  // (stack authors, `+meta.ts` files) import from `jsr:@rostok/cli/lib`.
  //
  // Per docs/design/v1-cli.md §8 the catalog is bundled into the CLI —
  // `stacks/*/+meta.ts` are statically imported from cli/catalog.ts,
  // so they ride along with the published binary.
  "name": "@rostok/cli",
  "version": "1.18.1",
  "license": "MIT",
  "exports": {
    ".": "./cli/+main.ts",
    "./lib": "./cli/+lib.ts"
  },
  "publish": {
    // Ship the CLI + only `+meta.ts` from `stacks/`. Everything else in
    // `stacks/`, `scripts/`, `docs/` is rostok-repo dev
    // tooling — the published CLI never reads it.
    //
    // JSR's exclude doesn't follow gitignore semantics for negative
    // globs in nested directories. The working syntax is to exclude
    // `stacks/**` AND re-include every needed file by explicit path.
    // Two things must stay in sync with this list:
    //   - cli/catalog.ts (the `import` per stack — +meta.ts only)
    //   - cli/deploy/shipped-stacks.ts (compose.yml/hooks/static config
    //     `rostok deploy` needs at runtime — see #203).
    // `deno publish --dry-run` lists exactly what ships; use it to check
    // this block after adding a stack or a deploy file.
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*_test.ts",
      "scripts",
      "scripts/**",
      "docs",
      "docs/**",
      "stacks/**",
      "stacks/**/*",
      "stacks/*/+meta.ts",
      "!stacks/traefik/+meta.ts",
      "!stacks/traefik/compose.yml",
      "!stacks/traefik/before.deploy.ts",
      "!stacks/traefik/after.deploy.ts",
      "!stacks/traefik/dynamic/00-base.yml",
      "!stacks/gatus/+meta.ts",
      "!stacks/gatus/compose.yml",
      "!stacks/gatus/config.yml",
      "!stacks/gatus/before.deploy.ts",
      "!stacks/gatus/after.deploy.ts",
      "!stacks/vaultwarden/+meta.ts",
      "!stacks/vaultwarden/compose.yml",
      "!stacks/jellyfin/+meta.ts",
      "!stacks/jellyfin/compose.yml",
      "!stacks/filebrowser/+meta.ts",
      "!stacks/filebrowser/compose.yml",
      "!stacks/librespeed/+meta.ts",
      "!stacks/librespeed/compose.yml",
      "!stacks/deepseek-harness/+meta.ts",
      "!stacks/deepseek-harness/systemd/dsh.service",
      "!stacks/watchtower/+meta.ts",
      "!stacks/watchtower/compose.yml",
      "!stacks/syncthing/+meta.ts",
      "!stacks/syncthing/compose.yml",
      "!stacks/syncthing/before.deploy.ts",
      "!stacks/syncthing/after.deploy.ts",
      "!stacks/home-assistant/+meta.ts",
      "!stacks/home-assistant/compose.yml",
      "!stacks/home-assistant/compose.traefik.yml",
      "!stacks/wireguard/+meta.ts",
      "!stacks/wireguard/compose.yml",
      "!stacks/ntfy/+meta.ts",
      "!stacks/ntfy/compose.yml",
      "!stacks/oko/+meta.ts",
      "!stacks/oko/compose.yml",
      "!stacks/immich/+meta.ts",
      "!stacks/immich/compose.yml",
      "!stacks/immich/hwaccel.ml.yml",
      "!stacks/immich/hwaccel.transcoding.yml",
      "!stacks/piped/+meta.ts",
      "!stacks/piped/before.deploy.ts",
      "!stacks/piped/compose.yml",
      "!stacks/piped/config.properties.template",
      "!stacks/piped/substitute-env.ts",
      "!stacks/transmission/+meta.ts",
      "!stacks/transmission/compose.yml",
      "!stacks/playwright/+meta.ts",
      "!stacks/playwright/Dockerfile.mcp-proxy",
      "!stacks/playwright/after.deploy.ts",
      "!stacks/playwright/compose.yml",
      "!stacks/searxng/+meta.ts",
      "!stacks/searxng/before.deploy.ts",
      "!stacks/searxng/compose.yml",
      "!stacks/searxng/limiter.toml",
      "!stacks/searxng/searxng-settings.yml",
      "!stacks/open-webui/+meta.ts",
      "!stacks/open-webui/Dockerfile.mcpo",
      "!stacks/open-webui/after.deploy.ts",
      "!stacks/open-webui/compose.yml",
      "!stacks/open-webui/hook-lib.ts",
      "!stacks/open-webui/init-models.py",
      "!stacks/open-webui/mcpo-config.json",
      "!stacks/audiobookshelf/+meta.ts",
      "!stacks/audiobookshelf/compose.yml",
      "!stacks/metube/+meta.ts",
      "!stacks/metube/compose.yml",
      "!stacks/woodpecker/+meta.ts",
      "!stacks/woodpecker/compose.yml",
      "!stacks/woodpecker/db-helper.ts",
      "!stacks/usememos/+meta.ts",
      "!stacks/usememos/compose.yml",
      "!stacks/victoria-metrics/+meta.ts",
      "!stacks/victoria-metrics/compose.yml",
      "!stacks/akaunting/+meta.ts",
      "!stacks/akaunting/compose.yml",
      "!stacks/akaunting/health.html",
      "!stacks/gitea/+meta.ts",
      "!stacks/gitea/compose.yml",
      "!stacks/gitea/public/robots.txt",
      "!stacks/traggo/+meta.ts",
      "!stacks/traggo/compose.yml",
      "!stacks/docker-registry/+meta.ts",
      "!stacks/docker-registry/compose.yml",
      "!stacks/docker-registry/before.deploy.ts",
      "!stacks/docker-sock-proxy/+meta.ts",
      "!stacks/docker-sock-proxy/compose.yml",
      "!stacks/caldav-mcp/+meta.ts",
      "!stacks/caldav-mcp/Dockerfile",
      "!stacks/caldav-mcp/caldav-mcp.lock",
      "!stacks/caldav-mcp/compose.yml",
      "!stacks/email-mcp/+meta.ts",
      "!stacks/email-mcp/before.deploy.ts",
      "!stacks/email-mcp/compose.yml",
      "!stacks/email-mcp/guard/+main.ts",
      "!stacks/email-mcp/guard/Dockerfile",
      "!stacks/email-mcp/guard/guard.ts",
      "!stacks/google-maps-mcp/+meta.ts",
      "!stacks/google-maps-mcp/Dockerfile",
      "!stacks/google-maps-mcp/compose.yml",
      "!stacks/github-mcp/+meta.ts",
      "!stacks/github-mcp/Dockerfile",
      "!stacks/github-mcp/compose.yml",
      "!stacks/github-mcp/http-wrapper.mjs",
      "!stacks/zond/+meta.ts",
      "!stacks/zond/before.deploy.ts",
      "!stacks/zond/compose.yml",
      "!stacks/zond/config.yml",
      "!stacks/omni-tools/+meta.ts",
      "!stacks/omni-tools/compose.yml",
      "!stacks/adguard/+meta.ts",
      "!stacks/adguard/compose.yml",
      "!stacks/cloudflared/+meta.ts",
      "!stacks/cloudflared/compose.yml",
      "!stacks/healthchecks/+meta.ts",
      "!stacks/healthchecks/compose.yml",
      "!stacks/healthchecks/entrypoint.sh",
      "!stacks/nginx/+meta.ts",
      "!stacks/nginx/compose.yml",
      "!stacks/ollama/+meta.ts",
      "!stacks/ollama/compose.yml",
      "!stacks/umami/+meta.ts",
      "!stacks/umami/compose.yml",
      "!stacks/mirotalk/+meta.ts",
      "!stacks/mirotalk/cert-extract.py",
      "!stacks/mirotalk/compose.yml",
      "!stacks/bulwark/+meta.ts",
      "!stacks/bulwark/compose.yml",
      "!stacks/caldiy/+meta.ts",
      "!stacks/caldiy/after.deploy.ts",
      "!stacks/caldiy/compose.yml",
      "!stacks/mig/+meta.ts",
      "!stacks/mig/compose.yml",
      "!stacks/caldav-tasks-web/+meta.ts",
      "!stacks/caldav-tasks-web/compose.yml",
      "!stacks/stalwart/+meta.ts",
      "!stacks/stalwart/after.deploy.ts",
      "!stacks/stalwart/before.deploy.ts",
      "!stacks/stalwart/cert-sync.py",
      "!stacks/stalwart/compose.yml",
      "!stacks/stalwart/config.json",
      "!stacks/stalwart/dkim.ts",
      "!stacks/stalwart/mta-sts/html/.well-known/mta-sts.txt.template",
      "!stacks/stalwart/mta-sts/nginx.conf",
      "!stacks/stalwart/reports.ts",
      "!stacks/pangolin/+meta.ts",
      "!stacks/pangolin/before.deploy.ts",
      "!stacks/pangolin/compose.yml",
      "!stacks/pangolin/traefik/dynamic/00-pangolin.yml",
      "!stacks/pangolin/traefik/traefik_config.yml",
      "!stacks/authelia/+meta.ts",
      "!stacks/authelia/before.deploy.ts",
      "!stacks/authelia/compose.yml"
    ]
  },
  "exclude": [
    // Guard: `servers/` belongs to a user's own rostok project, never to
    // this checkout, and is gitignored. `deno fmt` and `deno lint` skip
    // gitignored paths on their own, but `deno check` does not, so a stray
    // copy would otherwise join the type-check set.
    "servers",
    "**/.vite/*",
    "**/.cache/*",
    "**/dist/*",
    ".volumes",
    ".git",
    "node_modules",
    "dist",
    "build",
    "docs",
    "**/.dockerignore",
    "**/.gitguardian.yml",
    "**/.vscode/**",
    "**/.woodpecker.yml",
    "**/AGENTS.md",
    "**/LICENSE",
    ".playwright-mcp",
    "*.lock"
  ],
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "semiColons": false
  }
}
