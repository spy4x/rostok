{
  "tasks": {
    // #region Ansible
    "ansible": {
      "command": "deno run -A ./scripts/ansible/+main.ts",
      "description": "🔧 Run Ansible playbooks (auto-loads env vars)"
    },
    // #endregion Ansible

    // #region Deploy
    "deploy": {
      "command": "deno run -A ./scripts/deploy/+main.ts",
      "description": "🚀 Deploy to remote server. Usage: deploy <server> [stack]"
    },
    "ssh": {
      "command": "deno run -A ./scripts/ssh/+main.ts",
      "description": "🔐 SSH into server (interactive) or run remote command: ssh <server> [cmd...]"
    },
    // #endregion Deploy

    // #region Backup
    // Each server has its own .env with BACKUP_PATHS and SSH_ADDRESS.
    // Override the env-file path with the SERVER_ENV env var.
    "backup": {
      "command": "deno run --env-file=.env.root --env-file=servers/home/.env -A ./scripts/backup/+main.ts",
      "description": "💾 Run backup for all services using Restic"
    },
    "backup:restore": {
      "command": "deno run -A ./scripts/backup/restore.ts",
      "description": "📥 Restore service data from backup (interactive)"
    },
    "backup:recover": {
      "command": "deno run --env-file=.env.root --env-file=servers/home/.env -A ./scripts/backup/recover.ts",
      "description": "🚧 Recover corrupted restic repos (dry-run by default, pass --execute)"
    },
    "backup:recover:dry-run": {
      "command": "deno run --env-file=.env.root --env-file=servers/home/.env -A ./scripts/backup/recover.ts -- --dry-run",
      "description": "🔍 Scan and report corrupted restic repos without modifying anything"
    },
    "offline-backup": {
      "command": "deno run --env-file=.env.root -A ./scripts/offline-backup/+main.ts",
      "description": "🗄️ Backup/restore to/from external drive (monthly offline backups)"
    },
    // #endregion Backup

    // #region Encryption
    // age64 — per-value age encryption. Each value independent — only changed lines diff.
    "env:encrypt": {
      "command": "deno run -R -W=. --allow-run=age,git scripts/encryption/encrypt.ts",
      "description": "🔐 Encrypt .env → .env.age (only changed values re-encrypted)"
    },
    "env:decrypt": {
      "command": "deno run -R -W=. --allow-run=age,git scripts/encryption/decrypt.ts",
      "description": "🔓 Decrypt .env.age → .env (decrypts age64 values)"
    },
    // #endregion Encryption

    // #region Git Hooks
    // Installs pre-commit, post-checkout, post-merge hooks in shared .git/hooks/
    // Works with worktrees (resolves via git rev-parse --git-common-dir).
    "hooks:install": "deno run -R -W --allow-run=git scripts/hooks/install.ts",
    "hooks:pre-commit": "deno task check && deno task env:encrypt",
    "hooks:post-checkout": "deno task env:decrypt",
    "hooks:post-merge": "deno task env:decrypt",
    // #endregion Git Hooks

    // #region Checks
    "check": {
      "description": "✅ Run all checks (lint, fmt, types, tests)",
      "dependencies": [
        "lint:check",
        "fmt:check",
        "ts:check",
        "test"
      ]
    },
    "fmt:fix": {
      "command": "deno fmt",
      "description": "✨ Auto-format code"
    },
    "fmt:check": {
      "command": "deno fmt --check",
      "description": "📝 Check code formatting"
    },
    "lint:fix": {
      "command": "deno lint --fix",
      "description": "🔍 Auto-fix linting issues"
    },
    "lint:check": {
      "command": "deno lint",
      "description": "🔍 Check for linting issues"
    },
    "ts:check": {
      "command": "deno check **/*.ts",
      "description": "📘 Type-check TypeScript files"
    },
    "test": {
      // -R/-W: findEnvFiles() tests build a throwaway dir tree (nested
      // worktree fixtures) under the system temp dir and walk it.
      // --allow-run: cli/encrypt.ts shells out to `age` for detection,
      // `age-keygen` for test fixtures, and `deno task env:encrypt` for
      // the re-encrypt hook. Broad run access mirrors the production
      // encrypt/decrypt task permissions.
      "command": "deno test --allow-env --allow-run -R -W",
      "description": "🧪 Run tests"
    },
    "fix": {
      "command": "echo '🔧 All fixes applied!'",
      "description": "🔧 Auto-fix all issues (lint + format)",
      "dependencies": [
        "lint:fix",
        "fmt:fix"
      ]
    }
    // #endregion Checks
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@rostok/cli": "./cli/+lib.ts",
    "@scripts/backup": "./scripts/backup/src/+lib.ts",
    "@std/assert": "jsr:@std/assert@^1.0.17",
    "@std/dotenv": "jsr:@std/dotenv",
    "@std/encoding": "jsr:@std/encoding@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.21",
    "@std/path": "jsr:@std/path@^1.1.4",
    "arktype": "npm:arktype@^2.2.3",
    "yaml": "npm:yaml@^2.8.2"
  },
  // JSR package metadata. `rostok` ships the CLI as a publishable binary
  // at jsr.io/@rostok/cli. Per docs/design/v1-cli.md §8 the catalog is
  // bundled into the CLI — `stacks/*/+meta.ts` are statically imported
  // from cli/catalog.ts, so they ride along with the published binary.
  "name": "@rostok/cli",
  "version": "1.0.0",
  "license": "MIT",
  "exports": {
    ".": "./cli/+lib.ts",
    "./cli": "./cli/+main.ts"
  },
  "publish": {
    // Ship the CLI + only `+meta.ts` from `stacks/`. Everything else in
    // `stacks/`, `scripts/`, `ansible/`, `docs/` is rostok-repo dev
    // tooling — the published CLI never reads it.
    //
    // JSR's exclude doesn't follow gitignore semantics for negative
    // globs in nested directories. The working syntax is to exclude
    // `stacks/**` AND re-include each top-level +meta.ts by explicit
    // path. The catalog loader (cli/catalog.ts) keeps an explicit
    // `import` per stack, so adding a stack is a 2-line change here AND
    // in catalog.ts — keep them in sync.
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*_test.ts",
      "ansible",
      "ansible/**",
      "scripts",
      "scripts/**",
      "docs",
      "docs/**",
      "stacks/**",
      "stacks/**/*",
      "stacks/*/+meta.ts",
      "!stacks/traefik/+meta.ts",
      "!stacks/gatus/+meta.ts",
      "!stacks/vaultwarden/+meta.ts",
      "!stacks/jellyfin/+meta.ts",
      "!stacks/filebrowser/+meta.ts",
      "!stacks/librespeed/+meta.ts"
    ]
  },
  "exclude": [
    "**/.vite/*",
    "**/.cache/*",
    "**/dist/*",
    ".volumes",
    ".git",
    "node_modules",
    "dist",
    "build",
    "docs",
    "ansible",
    "**/.dockerignore",
    "**/.env.root.example",
    "**/.gitguardian.yml",
    "**/.vscode/**",
    "**/.woodpecker.yml",
    "**/AGENTS.md",
    "**/LICENSE",
    ".playwright-mcp",
    "*.lock"
  ],
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "semiColons": false
  }
}
