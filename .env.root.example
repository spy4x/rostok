# These vars are used by multiple servers
PROJECT=hl
BACKUPS_PASSWORD=GENERATE_A_STRONG_SECRET

# BACKUP_PATHS - JSON array of backup sources: [{"source": "path", "target": "folder-name"}]
# Example: [{"source":"~/sync/backups","target":"restic-repos"},{"source":"~/sync/cloud-light-backups","target":"cloud-light-backups"}]
BACKUP_PATHS='[{"source":"~/sync/backups","target":"restic-repos"}]'

# Homelab system user
HOMELAB_USER=spy4x

# Basic auth credentials (used across services)
BASIC_AUTH_USER=spy4x
# Generate with: htpasswd -nB spy4x | cut -d: -f2
# Then wrap in single quotes to prevent $ from being interpreted as env vars
BASIC_AUTH_PASSWORD='$2y$05$YOUR_HASHED_PASSWORD_HERE'
# Generate with: echo -n "${BASIC_AUTH_USER}:${BASIC_AUTH_PASSWORD_UNHASHED}" | base64
BASIC_AUTH_BASE64=YOUR_BASE64_CREDENTIALS_HERE

# For important notifications, password recovery, SSL renewal alerts, etc.
CONTACT_EMAIL=your@email

# Docker group GID for proper permissions (check number with: getent group docker)
# 990 is common on many systems, but verify for your setup
DOCKER_GROUP_ID=990

# Cloudflare API token for DNS management
# Generate in Cloudflare Dashboard: My Profile → API Tokens → Create (Zone:DNS:Edit)
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE