# rostok project-level env (template)
#
# This file is the template the rostok CLI uses to scaffold the
# `.env.root` of a new rostok project. Edit the values, then run
# `deno task env:encrypt` to produce `.env.root.age` for git.
#
# All values below are placeholders. REPLACE before use.

#region Project
# Project identifier — used as the container/prefix on a Docker host.
# Must be 2-8 lowercase letters. Default: `hl`.
PROJECT=hl
#endregion

#region Backups
# Password for the Restic backup repository. Generate with:
#   head -c 32 /dev/urandom | base64 | tr -d '=' | head -c 32
BACKUPS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SECRET
#endregion

#region SSH
# Default SSH user for all servers. Reuse across machines for simplicity.
SSH_USER=REPLACE_WITH_YOUR_LINUX_USERNAME
#endregion

#region Auth
# Basic-auth credentials used by services behind Traefik basic auth.
# Authelia SSO is preferred for anything with real users.
# Generate the hash with:
#   htpasswd -nB YOUR_USER | cut -d: -f2
BASIC_AUTH_USER=REPLACE_WITH_USERNAME
BASIC_AUTH_PASSWORD='$2y$05$REPLACE_WITH_GENERATED_HASH'
# Generate the base64 form with:
#   echo -n "${BASIC_AUTH_USER}:${BASIC_AUTH_PASSWORD_UNHASHED}" | base64
BASIC_AUTH_BASE64=REPLACE_WITH_BASE64_OF_USER_COLON_PASSWORD
#endregion

#region TLS
# Email used by Let's Encrypt for account registration and expiry alerts.
CONTACT_EMAIL=REPLACE_WITH_YOUR_EMAIL
#endregion

#region DNS
# Cloudflare API token — only needed for rostok server commands that
# manage DNS records (e.g. adding a new server). Generate one at:
#   Cloudflare Dashboard → My Profile → API Tokens → Create
#   Permissions: Zone:DNS:Edit on the zones you'll manage.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
#endregion
