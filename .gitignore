.volumes
dist
build
.idea
.DS_Store
node_modules
*.passwd

# Configs
.env
.env.*
*.env
!.env.example
!*.env.example

# @spy4x/server/env-age64's atomic-write leftover, if a crash ever left
# one behind (same directory as the plaintext or encrypted file it was
# writing).
.age64-tmp-*

# Guard: a server tree (per-server .env + configs) belongs to a user's
# own rostok project, never to this checkout.
servers/

# Age encryption keys (never commit!)
.age/
key.txt

.playwright-mcp/
todos.txt

# Rendered secrets (do not commit)
stacks/*/config.toml
stacks/*/*.rendered
stacks/*/mta-sts/html/.well-known/mta-sts.txt
*.sops-backup

# Claude Code local settings (machine-specific, do not commit)
.claude/settings.local.json
