.volumes
dist
build
.idea
.DS_Store
node_modules
*.passwd

# Configs
.env
.env.*
*.env
!.env.example
!*.env.example
!.env.root.example

# Private server directories — not tracked. Only servers/demo/ is a public
# template. Private server configs (including .env.age) are gitignored and
# kept on disk for local use; backed up via Syncthing + the restic backup
# pipeline. See servers/README.md.
servers/cloud/
servers/offsite/
servers/portable/

# servers/home is special: the dash subdirectory ships public code
# (template + deploy script + PWA assets), so it is tracked like any other
# stack source. The .env file holds secrets — ignored explicitly.
servers/home/.env
servers/home/.env.age

# Age encryption keys (never commit!)
.age/
key.txt

.playwright-mcp/
todos.txt

# Rendered secrets (do not commit; rendered by before.deploy.ts)
stacks/*/config.toml
stacks/*/*.rendered
stacks/*/mta-sts/html/.well-known/mta-sts.txt
*.sops-backup

# Claude Code local settings (machine-specific, do not commit)
.claude/settings.local.json

# Generated by before.deploy.ts at deploy time — never commit
servers/home/configs/dash/index.html
servers/home/configs/dash/health.js
