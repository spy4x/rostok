.volumes
dist
build
.idea
.DS_Store
node_modules
*.passwd
# Generated artifacts. We no longer generate per-stack compose override files
# (syncthing's override is now committed at
# servers/<server>/compose-override/<stack>.yml), but keep the pattern in
# gitignore in case a future before.deploy.ts creates ad-hoc fragments.
stacks/**/docker-compose.override.yml

# Configs
.env
.env.*
*.env
!.env.example
!*.env.example
!.env.root.example
!.env.age
!*.env.age
!.env.root.age

# Age encryption keys (never commit!)
.age/
key.txt

.playwright-mcp/
todos.txt.playwright-mcp/

# Rendered secrets (do not commit; rendered by before.deploy.ts)
stacks/*/config.toml
stacks/*/*.rendered
*.sops-backup
