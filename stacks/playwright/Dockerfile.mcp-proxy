FROM mcr.microsoft.com/playwright:v1.60.0-noble
RUN apt-get update -qq && apt-get install -y -qq python3 python3-pip python3-venv > /dev/null 2>&1 && \
    python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --quiet mcp-proxy==0.12.0 mcp==1.30.0 && \
    npm install -g --silent @playwright/mcp@0.0.74
ENV PATH="/opt/venv/bin:$PATH"
ENTRYPOINT ["python3", "-m", "mcp_proxy", "--port", "8099", "--host", "0.0.0.0", "--stateless", "-e", "PLAYWRIGHT_BROWSERS_PATH", "/ms-playwright", "--", "playwright-mcp", "--browser", "chromium", "--headless", "--no-sandbox"]
