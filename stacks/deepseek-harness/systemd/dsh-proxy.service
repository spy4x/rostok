[Unit]
Description=DeepSeek Harness LAN proxy (socat) — 0.0.0.0:3081 → 127.0.0.1:3080
Documentation=https://github.com/spy4x/rostok/tree/main/stacks/deepseek-harness
# dsh binds 127.0.0.1:3080 (its safe loopback default). Binding
# 0.0.0.0:3080 in socat would conflict at the kernel level — IPv4
# wildcards cover loopback, so 0.0.0.0:3080 and 127.0.0.1:3080 are
# mutually exclusive. Use 0.0.0.0:3081 instead and document the
# port offset in the README.
After=dsh.service
BindsTo=dsh.service

[Service]
Type=simple
# `fork` accepts multiple connections (dsh is single-threaded but
# serves many concurrent clients). `reuseaddr` avoids "address in
# use" after a fast restart. No TLS termination here — for HTTPS,
# run Traefik on the host (rostok catalog: traefik) and let it
# forward to 127.0.0.1:3080; disable this unit in that case.
ExecStart=/usr/bin/socat TCP-LISTEN:3081,reuseaddr,fork,bind=0.0.0.0 TCP:127.0.0.1:3080
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
