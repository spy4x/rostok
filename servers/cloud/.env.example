# Cloud Server Environment Configuration
# Copy this file to .env and fill in your actual values

SERVER_NAME=cloud
# SSH username for Ansible and deployment
HOMELAB_USER=spy4x
# SSH connection details for deployment
SSH_ADDRESS=spy4x@your-server-ip
SSH_PORT=22
# SSH_PRIVATE_KEY_FILE=~/.ssh/id_rsa  # Optional: Path to SSH private key (uses SSH agent by default)
TIMEZONE=Europe/Berlin
DOMAIN=yourdomain.com

#region Ansible
# Firewall ports to open (comma-separated list)
# Format: port/protocol (e.g., 80/tcp,443/tcp)
FIREWALL_PORTS=80/tcp,443/tcp,${SSH_PORT}/tcp,25/tcp,465/tcp,587/tcp,993/tcp,22000/tcp,22000/udp,21027/udp
# 80/tcp, 443/tcp - Traefik (HTTP/HTTPS)
# ${SSH_PORT}/tcp - SSH custom port
# 25/tcp - Mailserver (SMTP incoming)
# 465/tcp - Mailserver (SMTPS secure)
# 587/tcp - Mailserver (SMTP submission)
# 993/tcp - Mailserver (IMAPS secure)
# 22000/tcp, 22000/udp, 21027/udp - Syncthing (sync protocol and discovery)
#endregion Ansible

#region Docker
# Get with: getent group docker | cut -d: -f3
DOCKER_GROUP_ID=990
#endregion Docker

# Ntfy notification tokens and URLs for system monitoring
# Get tokens from your ntfy instance: Settings → Access Tokens
NTFY_TOKEN_HARDWARE=tk_YOUR_HARDWARE_TOKEN_HERE
NTFY_TOKEN_SECURITY=tk_YOUR_SECURITY_TOKEN_HERE
NTFY_TOKEN_UPTIME=tk_YOUR_UPTIME_TOKEN_HERE
NTFY_URL_HARDWARE=https://ntfy.yourdomain.com/hardware
NTFY_URL_SECURITY=https://ntfy.yourdomain.com/security
NTFY_URL_UPTIME=https://ntfy.yourdomain.com/uptime
#endregion Ansible

#region Paths
# Configure paths for your storage layout
BASE_PATH=~/cloudlab
PATH_APPS=${BASE_PATH}/apps                     # Docker services location
VOLUMES_PATH=${PATH_APPS}/.volumes
PATH_SYNC=${BASE_PATH}/sync                     # Syncthing shared folder
PATH_BACKUPS=${PATH_SYNC}/cloud-light-backups   # Backup storage
#endregion Paths

#region Proxy
# Traefik reverse proxy configuration
PROXY_SUBDOMAIN=proxy-cloud
PROXY_CPU_LIMIT=1
PROXY_MEM_LIMIT=512M
BASIC_AUTH_USER=admin
# Generate with: echo $(htpasswd -nB admin) | sed 's/\$/\$\$/g'
BASIC_AUTH_PASSWORD=$$2y$$05$$YOUR_HASHED_PASSWORD_HERE
#endregion Proxy

#region Backups
# Syncthing and backup notification configuration
SYNCTHING_SUBDOMAIN=sync-cloud
SYNCTHING_CPU_LIMIT=1
SYNCTHING_MEM_LIMIT=1024M
#region LibreSpeed
# LibreSpeed subdomain prefix (speed-<server>)
LIBRESPEED_SUBDOMAIN=speed-cloud
#endregion
NTFY_URL_BACKUPS=https://ntfy-cloud.yourdomain.com/backups
NTFY_TOKEN_BACKUPS=tk_YOUR_BACKUP_TOKEN_HERE
# Optional: Healthchecks.io-style ping URL for backup monitoring
# Create a check in Healthchecks, then paste the ping URL here
# If backups don't ping within expected time, Healthchecks will alert you
HEALTHCHECKS_BACKUP_URL=https://healthchecks.yourdomain.com/ping/YOUR_CHECK_UUID
#endregion Backups

#region Uptime
# Gatus health monitoring configuration
GATUS_CONFIG_PATH=${PATH_APPS}/configs/gatus.yml
GATUS_SUBDOMAIN=uptime-cloud
NTFY_TOPIC_UPTIME=uptime
NTFY_TOKEN_UPTIME=tk_YOUR_UPTIME_TOKEN_HERE
#endregion Uptime

#region WatchTower
# Container auto-update configuration
WATCHTOWER_CPU_LIMIT=0.5
WATCHTOWER_MEM_LIMIT=256M
#endregion WatchTower

#region NTFY
# Ntfy notification service
NTFY_SUBDOMAIN=ntfy-cloud
NTFY_URL=https://ntfy-cloud.yourdomain.com
#endregion NTFY

#region Stalwart Mail Server
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
STALWART_ADMIN_PASSWORD=YOUR_STALWART_ADMIN_PASSWORD_HERE
STALWART_SUBDOMAIN=stalwart

# SMTP Configuration
# These credentials are for sending emails from services
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_FROM=noreply@yourdomain.com
SMTP_USERNAME=noreply@yourdomain.com
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
#endregion Stalwart Mail Server

#region Healthchecks
# Healthchecks.io monitoring secret key
# Generate with: openssl rand -base64 32
HEALTHCHECKS_SECRET_KEY=YOUR_HEALTHCHECKS_SECRET_KEY_HERE
HEALTHCHECKS_BACKUP_URL=https://healthchecks.antonshubin.com/ping/UUID
#endregion Healthchecks

#region Upwork Triage
# Webhook triage for Upwork job alerts via Vollna
# DeepSeek API key — https://platform.deepseek.com/
UPWORK_TRIAGE_DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY
# Telegram bot token from @BotFather
UPWORK_TRIAGE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Telegram chat ID to send notifications to
UPWORK_TRIAGE_TELEGRAM_CHAT_ID=your-chat-id
# Random secret for webhook auth (generate with: openssl rand -hex 32)
UPWORK_TRIAGE_WEBHOOK_AUTH_TOKEN=your-webhook-auth-token
#endregion Upwork Triage


