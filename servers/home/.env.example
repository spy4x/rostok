# Home Server Environment Configuration
# Copy this file to .env and fill in your actual values

SERVER_NAME=home
# SSH username for Ansible and deployment
HOMELAB_USER=spy4x
# SSH connection details for deployment
SSH_ADDRESS=your-server-hostname-or-ip
SSH_PORT=22
# SSH_PRIVATE_KEY_FILE=~/.ssh/id_rsa  # Optional: Path to SSH private key (uses SSH agent by default)
TIMEZONE=America/New_York
DOMAIN=yourdomain.com

#region Ansible
# Firewall ports to open (comma-separated list)
# Format: port/protocol (e.g., 80/tcp,443/tcp)
FIREWALL_PORTS=80/tcp,443/tcp,${SSH_PORT}/tcp,51413/tcp,51413/udp,53/tcp,53/udp,853/tcp,51820/udp,22000/tcp,22000/udp,21027/udp
# 80/tcp, 443/tcp - Traefik (HTTP/HTTPS)
# ${SSH_PORT}/tcp - SSH custom port
# 51413/tcp, 51413/udp - Transmission (BitTorrent)
# 53/tcp, 53/udp - AdGuard (DNS)
# 853/tcp - AdGuard (DNS-over-TLS)
# 51820/udp - WireGuard (VPN)
# 22000/tcp, 22000/udp, 21027/udp - Syncthing (sync protocol and discovery)

# Ntfy notification tokens and URLs for system monitoring
# Get tokens from your ntfy instance: Settings → Access Tokens
NTFY_TOKEN_HARDWARE=tk_YOUR_HARDWARE_TOKEN_HERE
NTFY_TOKEN_SECURITY=tk_YOUR_SECURITY_TOKEN_HERE
NTFY_TOKEN_UPTIME=tk_YOUR_UPTIME_TOKEN_HERE
NTFY_URL_HARDWARE=https://ntfy.yourdomain.com/hardware
NTFY_URL_SECURITY=https://ntfy.yourdomain.com/security
NTFY_URL_UPTIME=https://ntfy.yourdomain.com/uptime
#endregion Ansible

#region Docker
# Get with: getent group docker | cut -d: -f3
DOCKER_GROUP_ID=990
#endregion Docker

#region Paths
# Configure paths for your storage layout
# Adjust these based on your mounted drives
BASE_PATH=~/ssd-2tb
VOLUMES_PATH=${BASE_PATH}/apps/.volumes
PATH_APPS=${BASE_PATH}/apps                 # Docker services location
PATH_SYNC=${BASE_PATH}/sync                 # Syncthing shared folder
PATH_BACKUPS=${PATH_SYNC}/backups           # Backup storage
PATH_BOOKS=${BASE_PATH}/sync/archive/books  # AudioBookshelf library
PATH_MEDIA=${BASE_PATH}/media               # Main media directory
PATH_MOVIES=${BASE_PATH}/media/movies       # Jellyfin movies
PATH_SERIES=${BASE_PATH}/media/series       # Jellyfin TV shows
PATH_MUSIC=${BASE_PATH}/sync/archive/music  # Music library
PATH_OTHER=${BASE_PATH}/media/other         # Other media
PATH_PHOTOS=${BASE_PATH}/media/photos       # Immich photos
PATH_VIDEOS=${BASE_PATH}/media/videos       # Video files
#endregion Paths

#region Proxy
# Traefik reverse proxy configuration
PROXY_SUBDOMAIN=proxy-home
PROXY_CPU_LIMIT=2
PROXY_MEM_LIMIT=2048M
BASIC_AUTH_USER=admin
# Generate with: echo $(htpasswd -nB admin) | sed 's/\$/\$\$/g'
BASIC_AUTH_PASSWORD=$$2y$$05$$YOUR_HASHED_PASSWORD_HERE
#endregion Proxy

#region Backups
# Syncthing and backup notification configuration
SYNCTHING_SUBDOMAIN=sync-home
SYNCTHING_CPU_LIMIT=3
SYNCTHING_MEM_LIMIT=4096M
#region LibreSpeed
# LibreSpeed subdomain prefix (speed-<server>)
# Generate with: head -c 32 /dev/urandom | base64 | tr -d '=' | head -c 32
LIBRESPEED_SUBDOMAIN=speed-home
#endregion
NTFY_URL_BACKUPS=https://ntfy-home.yourdomain.com/backups
NTFY_TOKEN_BACKUPS=tk_YOUR_BACKUP_TOKEN_HERE
# Optional: Healthchecks.io-style ping URL for backup monitoring
# Create a check in Healthchecks, then paste the ping URL here
# If backups don't ping within expected time, Healthchecks will alert you
HEALTHCHECKS_BACKUP_URL=https://healthchecks.yourdomain.com/ping/YOUR_CHECK_UUID
#endregion Backups

#region Monitoring
# Gatus health monitoring configuration
GATUS_CONFIG_PATH=${PATH_APPS}/configs/gatus.yml
GATUS_SUBDOMAIN=uptime-home
NTFY_TOPIC_UPTIME=uptime
NTFY_TOKEN_UPTIME=tk_YOUR_UPTIME_TOKEN_HERE
#endregion Monitoring

#region NTFY
# Ntfy notification service
NTFY_SUBDOMAIN=ntfy-home
NTFY_URL=https://ntfy-home.yourdomain.com
#endregion NTFY

#region VaultWarden
# Password manager configuration
# Generate admin token with: echo -n "your-admin-password" | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
# IMPORTANT: Escape $ characters with $$ for Docker Compose (e.g., $$argon2id$$v=19...)
VAULTWARDEN_ADMIN_TOKEN='$$argon2id$$v=19$$m=65540,t=3,p=4$$YOUR_ARGON2_HASH_HERE'
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=false
VAULTWARDEN_SHOW_PASSWORD_HINT=false
VAULTWARDEN_LOGIN_RATELIMIT_MAX_BURST=10
VAULTWARDEN_LOGIN_RATELIMIT_SECONDS=60
VAULTWARDEN_INCOMPLETE_2FA_TIME_LIMIT=3
VAULTWARDEN_LOG_LEVEL=info
VAULTWARDEN_EMERGENCY_ACCESS_ALLOWED=true
#endregion VaultWarden

#region Woodpecker CI
# CI/CD configuration
# Generate secret with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=YOUR_64_CHAR_HEX_SECRET_HERE
WOODPECKER_ADMIN=your-github-username
# Get from GitHub OAuth App: Settings → Developer settings → OAuth Apps
WOODPECKER_GITHUB_CLIENT=YOUR_GITHUB_CLIENT_ID
WOODPECKER_GITHUB_SECRET=YOUR_GITHUB_CLIENT_SECRET
#endregion Woodpecker CI

#region Piped
# YouTube alternative database configuration
# Generate password with: head -c 32 /dev/urandom | base64 | head -c 32
PIPED_DB_NAME=piped
PIPED_DB_USER=piped
PIPED_DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
#endregion Piped

#region Immich
# Photo management configuration
# Generate password with: head -c 32 /dev/urandom | base64 | head -c 32
IMMICH_DB_PASSWORD=YOUR_IMMICH_DB_PASSWORD_HERE
# Generate API key with: openssl rand -base64 32
IMMICH_KIOSK_API_KEY=YOUR_IMMICH_API_KEY_HERE
IMMICH_KIOSK_PASSWORD=YOUR_KIOSK_PASSWORD_HERE
# ImmichMCP API key — create via Immich Web UI → Settings → API Keys
# Dedicated key for AI assistant access (read/search/create albums/assets)
IMMICH_MCP_API_KEY=YOUR_DEDICATED_IMMICH_API_KEY
#endregion Immich

#region WireGuard VPN
VPN_SUBDOMAIN=vpn-home
# DNS server for VPN clients (optional, defaults to Cloudflare: 1.1.1.1,8.8.8.8,9.9.9.9)
# Use your AdGuard Home IP for ad-blocking on VPN: VPN_DNS=192.168.0.100
VPN_DNS=192.168.0.100
# Number of VPN peer configs to generate
VPN_PEERS=4
#endregion WireGuard VPN

#region Healthchecks
HEALTHCHECKS_SECRET_KEY=YOUR_SECRET
HEALTHCHECKS_BACKUP_URL=https://healthchecks.antonshubin.com/ping/UUID
#endregion Healthchecks

#region SearXNG
# Privacy-respecting metasearch engine for OpenWebUI web search
# Generate secret with: openssl rand -hex 32
SEARXNG_SECRET_KEY=YOUR_64_CHAR_HEX_KEY
#endregion SearXNG

#region SMTP
# SMTP configuration for sending emails from services
SMTP_HOST=mail.${DOMAIN}
SMTP_PORT=587
SMTP_FROM=noreply@${DOMAIN}
SMTP_USERNAME=noreply@${DOMAIN}
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
#endregion SMTP

#region Cal.diy
# Cal.diy scheduling service
# Generate password with: openssl rand -base64 32 | head -c 32
CALDIY_DB_PASSWORD=YOUR_CALDIY_DB_PASSWORD
# Generate with: openssl rand -base64 32
CALDIY_NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET
# Generate with: openssl rand -hex 32
CALDIY_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY
# Optional: pin a specific version (default: latest)
# CALDIY_VERSION=v6.2.0
#endregion Cal.diy

#region OpenWebUI
# OpenAI-compatible API keys for multiple LLM providers (semicolon-separated)
# Each key maps to the corresponding URL in OPENAI_API_BASE_URLS
# Semicolon-separated API keys for OpenAI-compatible providers
# Format: KEY1;KEY2;KEY3
#   Key 1 → URL 1, Key 2 → URL 2, etc.
# Examples:
#   OPENAI_API_KEYS=sk-deepseek-key;sk-openai-key
#   OPENAI_API_BASE_URLS=https://api.deepseek.com/v1;https://api.openai.com/v1
OPENAI_API_KEYS=YOUR_SEMICOLON_SEPARATED_API_KEYS
OPENAI_API_BASE_URLS=YOUR_SEMICOLON_SEPARATED_BASE_URLS
# Optional: JSON config for each provider (model mapping, pricing, etc.)
OPENAI_API_CONFIGS={}
# Default models to show in the UI (comma-separated)
DEFAULT_MODELS=deepseek-chat,gemini-2.0-flash
# Secret key for JWT auth - generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=YOUR_64_CHAR_HEX_KEY
# HuggingFace token for downloading models (optional, removes rate limits)
# Create at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here
# Tika server for document content extraction (OCR, PDFs, Office docs)
# TIKA_SERVER_URL=http://tika:9998

# MiniMax (MiniMax M3 frontier coding/agentic model)
# OpenAI-compatible endpoint. Subscribe at https://platform.minimax.io
# Add the key as a 3rd entry in OPENAI_API_KEYS (after deepseek + openai)
# and the URL as a 3rd entry in OPENAI_API_BASE_URLS.
# Example updated values:
#   OPENAI_API_KEYS=sk-deepseek;sk-openai;sk-api-YOUR_MINIMAX_KEY
#   OPENAI_API_BASE_URLS=https://api.deepseek.com/v1;https://api.openai.com/v1;https://api.minimax.io/v1
# Then add to DEFAULT_MODELS (comma-separated): MiniMax-M3
MINIMAX_API_KEY=REPLACE_WITH_YOUR_MINIMAX_API_KEY
#endregion OpenWebUI

#region Ollama-OpenWebUI
ENABLE_OLLAMA_API=true
OLLAMA_API_BASE_URL=http://ollama:11434
#endregion Ollama-OpenWebUI

#region Monica CRM
# Personal relationship manager (crm.${DOMAIN})
# Generate passwords with: head -c 32 /dev/urandom | base64 | head -c 32
MONICA_DB_ROOT_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
MONICA_DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
# Comma-separated trusted proxy IPs/CIDRs (default: 0.0.0.0/0)
# MONICA_TRUSTED_PROXIES=0.0.0.0/0
#endregion Monica CRM

#region Mirotalk
# P2P video conferencing (talk.${DOMAIN})
# No configuration needed - ephemeral service
#endregion Mirotalk

#region Reitti
# Transit/journey planning (loc.${DOMAIN})
# No configuration needed
#endregion Reitti

#region OmniTools
# Developer toolbelt (tools.${DOMAIN})
# Stateless, all processing is client-side
# No configuration needed
OMNITOOLS_SUBDOMAIN=tools
#endregion OmniTools

#region Usememos
# Lightweight notes (notes.${DOMAIN})
# No configuration needed (SQLite-backed)
#endregion Usememos

#region Ollama
# Local LLM with GPU (ollama.${DOMAIN})
# Requires NVIDIA Container Toolkit on the host
# After deploy: docker exec ollama ollama pull gemma2:2b
OLLAMA_MEM_LIMIT=8G
OLLAMA_CPU_LIMIT=2
#endregion Ollama

#region Grafana
# Monitoring dashboards (metrics.${DOMAIN})
GRAFANA_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD
#endregion Grafana

#region Akaunting
# Accounting & invoicing (invoices.${DOMAIN})
# Generate password with: head -c 32 /dev/urandom | base64 | head -c 32
AKAUNTING_DB_ROOT_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
AKAUNTING_DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
#endregion Akaunting

#region Gitea
# Git hosting (git.${DOMAIN})
# Generate password with: head -c 32 /dev/urandom | base64 | head -c 32
GITEA_DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
#endregion Gitea

#region Traggo
# Self-hosted time tracking (time.${DOMAIN})
# No additional configuration needed
TRAGGO_MEM_LIMIT=128M
TRAGGO_CPU_LIMIT=0.2
#endregion Traggo

#region CalDAV MCP
# CalDAV MCP server for calendar management via Open WebUI
# Connects to local Radicale instance on Docker proxy network
CALDAV_SERVER_URL=http://hl-radicale:5232/
# Use the Radicale username and password
CALDAV_USERNAME=REPLACE_WITH_CALDAV_USERNAME
CALDAV_PASSWORD=REPLACE_WITH_CALDAV_PASSWORD
#endregion CalDAV MCP

#region Email MCP
# IMAP + SMTP MCP for Open WebUI / Claude Desktop / etc.
# Connects to the shared mailserver on the cloud (mail.${DOMAIN}).
# Account must exist: ssh cloud 'docker exec -it mailserver setup email add ${EMAIL_MCP_PRIMARY_USER}'
EMAIL_MCP_PRIMARY_USER=anton@${DOMAIN}
EMAIL_MCP_PRIMARY_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
#endregion Email MCP

#region Email MCP (NeatSoft)
# Secondary email account on neatsoft.dev domain
EMAIL_MCP_NEATSOFT_USER=anton@neatsoft.dev
EMAIL_MCP_NEATSOFT_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
#endregion Email MCP (NeatSoft)

#region Google Maps MCP
# Google Maps Platform API key for the Google Maps MCP server
# Get at: https://console.cloud.google.com → enable Places API (New) + Routes API
# Restrict the key to those APIs for safety.
GOOGLE_MAPS_API_KEY=AIzaSy_REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY
# Optional: restrict to a subset of tools to reduce LLM context usage
# Common subset: maps_search_places,maps_place_details,maps_geocode,maps_search_nearby
# GOOGLE_MAPS_ENABLED_TOOLS=maps_search_places,maps_place_details
# Optional: pin a specific mcp-google-map release (default: v0.0.52)
# MCP_GOOGLE_MAP_VERSION=v0.0.52
#endregion Google Maps MCP

#region VictoriaMetrics
# Grafana admin password for the VM stack (metrics-vm.${DOMAIN})
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
GRAFANA_VM_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD
#endregion VictoriaMetrics

#region Docker Registry
# Self-hosted container image registry (registry.${DOMAIN})
# No additional config needed
#endregion Docker Registry

#region Authelia
# SSO provider — config-driven auth (replaces Authentik)
# Generate session secret (used for both session and storage encryption):
#   openssl rand -hex 32
AUTHELIA_SESSION_SECRET=YOUR_64_CHAR_HEX_SESSION_SECRET
# Password hash for user spy4x is in servers/home/configs/authelia/users.yml
# Generate with: docker run --rm authelia/authelia:latest authelia crypto hash generate --password 'YOUR_PASSWORD'
# NOTE: if session secret changes, ALL existing sessions + encrypted storage become invalid
#endregion Authelia

#region Stalwart
# Mail server management UI (stalwart.${DOMAIN})
# NOTE: Stalwart is an alternative to the existing mailserver.
# Run only one mail server at a time due to port conflicts (25, 465, 587, 993).
# Management UI on port 8080.
# Admin password for initial setup (STALWART_RECOVERY_ADMIN)
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
STALWART_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD_HERE
#endregion Stalwart

#region Paperless-ngx
# Document management (docs.${DOMAIN})
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
PAPERLESS_DB_PASSWORD=YOUR_SECURE_PASSWORD
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
PAPERLESS_SECRET_KEY=YOUR_SECURE_SECRET
#endregion Paperless-ngx



#region Plausible
# Web analytics (analytics.${DOMAIN})
# NOTE: Requires ClickHouse ~512MB + PostgreSQL ~256MB (~1GB total)
# Generate passwords with: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32
PLAUSIBLE_DB_PASSWORD=YOUR_SECURE_PASSWORD
PLAUSIBLE_SECRET_KEY=YOUR_SECURE_SECRET_64_CHARS
PLAUSIBLE_SIGNING_SALT=YOUR_SECURE_SALT_32_CHARS
PLAUSIBLE_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
PLAUSIBLE_ADMIN_EMAIL=admin@${DOMAIN}
#endregion Plausible

#region Umami
# Lightweight analytics (stats.${DOMAIN})
# Generate with: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32
# Create admin on first visit, or use: admin / umami123!
UMAMI_APP_SECRET=YOUR_SECURE_SECRET
UMAMI_DB_PASSWORD=YOUR_SECURE_PASSWORD
#endregion Umami

#region Docker Socket Proxy
# Secure Docker API proxy — routes Docker API calls through restricted HAProxy.
# Limits which endpoints containers can access (containers, images, networks only).
# Used by OpenHands and other services that need Docker access.
# No configuration needed — runs on proxy network at hl-docker-sock-proxy:2375.
#endregion Docker Socket Proxy

#region OpenHands
# AI-driven development platform (code.${DOMAIN})
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
OPENHANDS_API_KEY=YOUR_RANDOM_32_CHAR_API_KEY
# Generate with: head -c 32 /dev/urandom | base64 | head -c 32
OPENHANDS_SECRET_KEY=YOUR_RANDOM_32_CHAR_SECRET_KEY
# GitHub personal access token for repo access (optional, can set via UI)
# Generate at: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Scopes: repo, issues, pull_requests, contents
# GITHUB_TOKEN=github_pat_YOUR_TOKEN
#endregion OpenHands

#region Monica MCP
# Monica CRM API token (Personal Access Token).
# Generate at: crm.${DOMAIN}/settings → API → Personal Access Tokens → Create New Token
# Scopes: at minimum "read" for contacts (write/delete for full MCP capabilities)
MONICA_API_TOKEN=YOUR_MONICA_API_TOKEN_PAT
#endregion Monica MCP
