<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="description" content="Anton Shubin's servers">
    <link rel="manifest" href="manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="assets/icon-192.png">
    <link rel="apple-touch-icon" href="assets/icon-192.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    >
    <style>
      :root {
        --bg-page: #0a0a0a;
        --bg-card: #141414;
        --bg-card-hover: #1c1c1c;
        --bg-stat: rgba(255, 255, 255, 0.04);
        --bg-stat-hover: rgba(255, 255, 255, 0.07);
        --border: rgba(255, 255, 255, 0.06);
        --border-hover: rgba(255, 255, 255, 0.12);
        --border-down: rgba(239, 68, 68, 0.55);
        --text-primary: #ededed;
        --text-secondary: #9a9a9a;
        --text-muted: #5e5e5e;
        --accent: #5e9eff;
        --accent-soft: rgba(94, 158, 255, 0.12);
        --healthy: #4ade80;
        --down: #ef4444;
        --radius-card: 14px;
        --radius-pill: 999px;
        --shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        --shadow-hover: 0 12px 28px rgba(0, 0, 0, 0.55);
        --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, monospace;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font);
        background: var(--bg-page);
        background-image: radial-gradient(
          ellipse 80% 50% at 50% -10%,
          rgba(94, 158, 255, 0.08),
          transparent 60%
        );
        background-attachment: fixed;
        color: var(--text-primary);
        min-height: 100vh;
        padding: 48px 20px 80px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
      }

      .header {
        text-align: center;
        margin-bottom: 32px;
      }

      .header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.02em;
        background: linear-gradient(180deg, #ffffff, #b8b8b8);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .header-sub {
        margin: 0;
        font-size: 13px;
        color: var(--text-muted);
        font-family: var(--font-mono);
        letter-spacing: 0.02em;
      }

      .search-wrap {
        max-width: 560px;
        margin: 0 auto 16px;
      }

      .search {
        width: 100%;
        padding: 14px 18px 14px 46px;
        font: 500 15px var(--font);
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        color: var(--text-primary);
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='%239a9a9a'><path fill-rule='evenodd' d='M9 3a6 6 0 100 12 6 6 0 000-12zM1 9a8 8 0 1114.32 4.906l4.387 4.387-1.414 1.414-4.387-4.387A8 8 0 011 9z' clip-rule='evenodd'/></svg>");
        background-repeat: no-repeat;
        background-position: 18px center;
        background-size: 16px 16px;
      }

      .search:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-soft);
      }

      .search::placeholder { color: var(--text-muted); }

      .search-hint {
        margin: 10px 0 0;
        text-align: center;
        font-size: 12px;
        color: var(--text-muted);
      }

      .search-hint kbd {
        font-family: var(--font-mono);
        font-size: 11px;
        background: var(--bg-stat);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1px 5px;
        color: var(--text-secondary);
      }

      .no-results {
        display: none;
        text-align: center;
        padding: 60px 20px;
        color: var(--text-muted);
        font-size: 14px;
      }

      .no-results.visible { display: block; }

      .section.hidden { display: none; }

      .section {
        margin: 0 0 48px;
      }

      .section-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin: 0 0 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
      }

      .section-title {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text-primary);
      }

      .section-stats {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-left: auto;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        background: var(--bg-stat);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
        font-variant-numeric: tabular-nums;
        font-family: var(--font-mono);
      }

      .pill-healthy { color: var(--healthy); }
      .pill-healthy::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--healthy);
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.5);
      }

      .pill-degraded {
        color: var(--down);
        border-color: rgba(239, 68, 68, 0.25);
        background: rgba(239, 68, 68, 0.08);
      }
      .pill-degraded::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--down);
        box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
      }

      .pill-empty {
        color: var(--text-muted);
        font-style: italic;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 14px;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .service {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        transition:
          background 0.18s ease,
          border-color 0.18s ease,
          transform 0.18s ease,
          box-shadow 0.18s ease;
        min-height: 168px;
        overflow: hidden;
      }

      .service:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-hover);
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
      }

      .service--down {
        border-color: var(--border-down);
        box-shadow: 0 0 0 1px var(--border-down), 0 0 20px rgba(239, 68, 68, 0.18);
      }

      .service--down:hover {
        border-color: var(--down);
        box-shadow: 0 0 0 1px var(--down), 0 0 24px rgba(239, 68, 68, 0.28);
      }

      .service-main {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-decoration: none;
        color: inherit;
        padding: 22px 14px 44px;
        min-height: 100%;
      }

      .service-main:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .service-icon {
        font-size: 36px;
        line-height: 1;
        margin-bottom: 10px;
        filter: saturate(1.05);
      }

      .service-name {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.005em;
        margin-bottom: 4px;
        color: var(--text-primary);
      }

      .service-description {
        font-size: 12px;
        line-height: 1.45;
        color: var(--text-secondary);
        margin: 0;
        padding: 0 6px;
      }

      .service-product {
        position: absolute;
        bottom: 12px;
        left: 14px;
        right: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        font-size: 11px;
        color: var(--text-muted);
        text-decoration: underline;
        text-decoration-color: rgba(255, 255, 255, 0.18);
        text-underline-offset: 2px;
        font-family: var(--font-mono);
        letter-spacing: 0.01em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .service-product:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }

      .service-product svg {
        flex: 0 0 9px;
        opacity: 0.7;
      }

      .service-product:hover svg { opacity: 1; }

      .empty-state {
        padding: 40px 24px;
        text-align: center;
        color: var(--text-muted);
        background: var(--bg-card);
        border: 1px dashed var(--border);
        border-radius: var(--radius-card);
        font-size: 14px;
      }

      .footer {
        margin-top: 64px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-size: 11px;
        color: var(--text-muted);
        font-family: var(--font-mono);
        letter-spacing: 0.02em;
      }

      .footer a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer a:hover { color: var(--accent); }

      @media (max-width: 640px) {
        body { padding: 24px 12px 60px; }
        .header h1 { font-size: 24px; }
        .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
        .service { min-height: 148px; }
        .service-main { padding: 16px 10px 38px; }
        .service-icon { font-size: 28px; }
        .service-name { font-size: 13px; }
        .service-description { font-size: 11px; }
        .section-header { gap: 8px; }
        .section-title { font-size: 18px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
        }
      }
    </style>
    <title>Anton Shubin's servers</title>
  </head>

  <body>
    <div class="page">
      <header class="header">
        <h1>Anton Shubin's servers</h1>
        <p class="header-sub">Single page for every self-hosted service — search, jump, check status</p>
      </header>

      <div class="search-wrap">
        <input
          type="search"
          class="search"
          id="search"
          placeholder="Search by name, product, or description…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search services"
        >
        <p class="search-hint">
          Try <kbd>/</kbd> to focus · <kbd>Esc</kbd> to clear
        </p>
      </div>

      <div id="noResults" class="no-results">No services match your search.</div>

      <main>
        <section class="section" data-server="home">
