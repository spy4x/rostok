            <div class="section-stats">
              <span class="pill pill-counter" data-counter>
                <span data-healthy>0</span><span>/</span><span data-total>0</span> healthy
              </span>
              <span class="pill pill-uptime" data-uptime>—</span>
            </div>
          </div>
          <ul class="grid">
            <!-- service cards rendered below -->
            <li class="service" data-endpoint="home_audiobookshelf">
              <a href="https://books.${DOMAIN}" target="_blank" rel="noopener" class="service-main">
