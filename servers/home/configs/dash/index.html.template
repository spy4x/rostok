    <script src="health.js"></script>
    <script>
      (function () {
        "use strict";

        // --- Search ---
        var search = document.getElementById("search");
        var noResults = document.getElementById("noResults");
        var sections = document.querySelectorAll(".section");

        function escapeRegex(s) {
          return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        }

        function buildMatcher(query) {
          if (!query) return function () { return true };
          if (query.length <= 2) {
            var re = new RegExp("\\b" + escapeRegex(query), "i");
            return function (text) { return re.test(text) };
          }
          return function (text) {
            return text.toLowerCase().indexOf(query) !== -1;
          };
        }

        function runSearch() {
          var q = search.value.trim();
          var matcher = buildMatcher(q);
          var anyVisible = false;
          sections.forEach(function (section) {
            var items = section.querySelectorAll(".service");
            var has = false;
            items.forEach(function (it) {
              var match = matcher(it.textContent);
              it.style.display = match ? "" : "none";
              if (match) has = true;
            });
            section.classList.toggle("hidden", !has);
            if (has) anyVisible = true;
          });
          noResults.classList.toggle("visible", !anyVisible && q !== "");
        }

        search.addEventListener("input", runSearch);

        // --- Health status from health.js ---
        var health = (window.__dashHealth && window.__dashHealth.services) || {};

        var counters = {};
        var maxUptime = {};

        document.querySelectorAll(".section").forEach(function (section) {
          var server = section.getAttribute("data-server");
          if (!server) return;
          counters[server] = { total: 0, healthy: 0 };
          section.querySelectorAll(".service").forEach(function (el) {
            var endpoint = el.getAttribute("data-endpoint");
            if (!endpoint) return;

            var status = health[endpoint];
            var main = el.querySelector(".service-main");

            if (status && status.healthy === false) {
              el.classList.add("service--down");
              if (status.uptimeUrl) {
                main.setAttribute("href", status.uptimeUrl);
                main.setAttribute("title", "Down — open uptime page");
              }
            }

            counters[server].total += 1;
            if (!status || status.healthy !== false) {
              counters[server].healthy += 1;
            }

            if (status && typeof status.uptime30d === "number") {
              if (maxUptime[server] === undefined || status.uptime30d > maxUptime[server]) {
                maxUptime[server] = status.uptime30d;
              }
            }
          });
        });

        document.querySelectorAll(".section").forEach(function (section) {
          var server = section.getAttribute("data-server");
          if (!server) return;
          var c = counters[server];
          var u = maxUptime[server];

          var counter = section.querySelector("[data-counter]");
          var uptimeEl = section.querySelector("[data-uptime]");

          if (c && counter) {
            var healthyEl = section.querySelector("[data-healthy]");
            var totalEl = section.querySelector("[data-total]");
            if (healthyEl) healthyEl.textContent = String(c.healthy);
            if (totalEl) totalEl.textContent = String(c.total);
            counter.classList.toggle("pill-healthy", c.healthy === c.total);
            counter.classList.toggle("pill-degraded", c.healthy < c.total);
          }

          if (uptimeEl && u !== undefined) {
            uptimeEl.textContent = u.toFixed(2) + "% · 30d";
          }
        });

        // --- Search autofocus on load (best effort) ---
        var interacted = false;
        function markInteracted() { interacted = true; }
        document.addEventListener("mousedown", markInteracted, { once: true, passive: true });
        document.addEventListener("keydown", function (e) {
          if (e.key !== "/" && e.key !== "Escape" && !e.metaKey && !e.ctrlKey) {
            markInteracted();
          }
        }, { passive: true });
        document.addEventListener("touchstart", markInteracted, { once: true, passive: true });
        document.addEventListener("scroll", markInteracted, { once: true, passive: true });

        function tryFocus() {
          if (!interacted && document.activeElement === document.body) {
            search.focus({ preventScroll: true });
          }
        }

        if (document.readyState === "complete") {
          tryFocus();
        } else {
          window.addEventListener("load", function () {
            setTimeout(tryFocus, 50);
          });
        }

        // --- Keyboard shortcuts ---
        document.addEventListener("keydown", function (e) {
          // "/" to focus search (unless already typing)
          if (e.key === "/" && document.activeElement !== search && !e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            search.focus();
            search.select();
          }
          // Esc to clear + blur
          if (e.key === "Escape" && document.activeElement === search) {
            search.value = "";
            runSearch();
            search.blur();
          }
        });
      })();
    </script>
  </body>
</html>